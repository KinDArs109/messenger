node_modules/
dist/
build/
.turbo/

# Секреты — никогда в репозиторий.
#
# Звёздочка после .env обязательна: правило «.env» совпадает только
# с этим именем ровно, а рядом успели завестись .env.neon-backup
# и подобные — со строкой подключения и паролем внутри.
.env
.env.*
!.env.example

# Дампы базы. Внутри хеши паролей, адреса почты и вся переписка —
# в репозитории им не место даже в приватном.
backups/

# Собранные приложения: под сотню мегабайт на файл, и каждая сборка
# новая. Git такое хранит вечно.
apps/desktop/release/

# Чужие исполняемые файлы — качаются с сайта разработчика, а не
# возятся в репозитории.
tools/

# Файлы пользователей
apps/server/uploads/

# Логи и отладка
*.log
npm-debug.log*
.pm2/
logs/

# Настоящий конфиг туннеля содержит UUID и путь к ключам
cloudflared/config.yml
cloudflared/*.json
cloudflared/*.exe

# Редакторы и ОС
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Ключ подписи Android — самое опасное, что тут есть.
#
# Android считает приложение своим по подписи: обновление, подписанное
# другим ключом, поверх старого не встанет — телефон потребует сначала
# удалить приложение, а с ним уедут и данные. Утёкший ключ — это чужое
# «обновление», которое телефон примет как наше.
#
# Хранить его надо там же, где резервные копии базы, и уж точно
# не в репозитории — тем более в открытом.
apps/android/signing/

# Сборки Android: apk, aab и всё, что делает gradle. Восстанавливается
# одной командой, весит десятки мегабайт и меняется каждый раз.
apps/android/build/
apps/android/app/build/
apps/android/*.apk
apps/android/*.apk.idsig
apps/android/*.aab
apps/android/manifest-checksum.txt

# Сборки оболочки. Правило про apps/desktop/release/ уже есть выше,
# но рядом успели завестись release2 и release-1017 — те же сто
# мегабайт на файл.
apps/desktop/release*/
apps/android/.gradle/
apps/android/gradle/
apps/android/gradlew
apps/android/gradlew.bat
apps/android/local.properties
# Собранный сервер: делается из исходников одной командой
apps/server/dist/
