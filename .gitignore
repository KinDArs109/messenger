node_modules/
dist/
build/
.turbo/

# Секреты — никогда в репозиторий.
#
# Звёздочка после .env обязательна: правило «.env» совпадает только
# с этим именем ровно, а рядом успели завестись .env.neon-backup
# и подобные — со строкой подключения и паролем внутри.
.env
.env.*
!.env.example

# Дампы базы. Внутри хеши паролей, адреса почты и вся переписка —
# в репозитории им не место даже в приватном.
backups/

# Собранные приложения: под сотню мегабайт на файл, и каждая сборка
# новая. Git такое хранит вечно.
apps/desktop/release/

# Чужие исполняемые файлы — качаются с сайта разработчика, а не
# возятся в репозитории.
tools/

# Файлы пользователей
apps/server/uploads/

# Логи и отладка
*.log
npm-debug.log*
.pm2/
logs/

# Настоящий конфиг туннеля содержит UUID и путь к ключам
cloudflared/config.yml
cloudflared/*.json
cloudflared/*.exe

# Редакторы и ОС
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
