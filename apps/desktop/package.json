{
  "name": "@messenger/desktop",
  "private": true,
  "version": "1.0.28",
  "description": "Мессенджер",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "node scripts/release.mjs",
    "check:overlay": "electron scripts/check-overlay.cjs",
    "check:call": "electron scripts/check-call.cjs",
    "check:app": "electron scripts/check-app.cjs",
    "check:game": "electron scripts/check-game.cjs",
    "check:release": "electron scripts/check-release.cjs",
    "check:emoji": "electron scripts/check-emoji.cjs",
    "check:voice-message": "electron scripts/check-voice-message.cjs",
    "check:steam": "electron scripts/check-steam.cjs",
    "check:screens": "electron scripts/check-screens.cjs",
    "check:poison": "electron scripts/check-poison.cjs",
    "check:undressed": "electron scripts/check-undressed.cjs",
    "check:share": "electron scripts/check-share.cjs",
    "check:codec": "electron scripts/check-codec.cjs",
    "check:sfu": "electron scripts/check-sfu.cjs",
    "check:capture": "electron scripts/check-capture.cjs"
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "ru.messenger.desktop",
    "productName": "Мессенджер",
    "executableName": "Messenger",
    "electronVersion": "40.10.6",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "games.cjs",
      "preload.cjs",
      "splash.html",
      "splash-preload.cjs",
      "overlay.html",
      "overlay-menu.html",
      "overlay-preload.cjs",
      "build/icon.ico",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://45.130.42.77.sslip.io/updates"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Мессенджер",
      "artifactName": "Messenger-Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "language": "1049"
    },
    "portable": {
      "artifactName": "Messenger-Portable.exe"
    }
  }
}
