// Схема базы данных мессенджера.
// После изменений: npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // База живёт на той же машине, что и сервер.
  //
  // Сначала она была в облаке — так было проще начать, когда локально
  // PostgreSQL поставить не удавалось. Оказалось, что это встроенная
  // в архитектуру зависимость от заграничного канала: рвётся он —
  // мессенджер мёртв для всех, а не только для владельца ноутбука.
  // Отдельный directUrl для миграций теперь не нужен: пула нет.
  url = env("DATABASE_URL")
}

// ─── Пользователи ────────────────────────────────────────────

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  username     String   @unique // латиница, участвует в упоминаниях
  displayName  String // отображаемое, любые символы
  avatarUrl    String?
  status       String   @default("offline") // online | idle | dnd | offline
  /** Что человек выбрал сам: online | idle | dnd | invisible.
   *
   *  Отдельно от status выше: там — что видят друзья, здесь — чего
   *  хочет он. Разница видна на «невидимом»: для друзей он «не в сети»,
   *  для себя — невидимый. И хранится это в базе, а не в памяти
   *  сервера: выбор должен пережить перезапуск, иначе человек,
   *  спрятавшийся невидимкой, однажды окажется на виду. */
  chosenStatus String   @default("online")

  // Одноразовые коды (TOTP). Секрет появляется на шаге настройки,
  // но до подтверждения кодом считается неподключённым: иначе
  // человек, не успевший добавить ключ в приложение, остался бы
  // с включённым способом входа, которым не может воспользоваться.
  totpSecret    String?
  totpEnabledAt DateTime?

  // Подтверждение почты. Код лежит хешем, как и всё, что даёт доступ:
  // дамп базы не должен позволять войти чужой учётной записью.
  emailVerifiedAt   DateTime?
  emailCodeHash     String?
  emailCodeExpires  DateTime?
  emailCodeSentAt   DateTime?
  // Счётчик неудачных попыток. Шестизначный код перебирается за
  // миллион запросов, и без ограничения это вопрос времени.
  emailCodeAttempts Int       @default(0)

  // Сброс пароля. Поля отдельные от подтверждения почты намеренно:
  // это разные процессы, и человек вполне может подтверждать адрес
  // и восстанавливать пароль одновременно — общие поля затирали бы
  // друг друга.
  resetCodeHash     String?
  resetCodeExpires  DateTime?
  resetCodeSentAt   DateTime?
  resetCodeAttempts Int       @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedServers       Server[]             @relation("ServerOwner")
  memberships        ServerMember[]
  messages           Message[]
  refreshTokens      RefreshToken[]
  readStates         ReadState[]
  reactions          Reaction[]
  channelMemberships ChannelParticipant[]
  createdInvites     Invite[]             @relation("InviteCreator")
  attachments        Attachment[]
  sentRequests       Friendship[]         @relation("FriendRequester")
  receivedRequests   Friendship[]         @relation("FriendAddressee")
  bans               Ban[]                @relation("BannedUser")
  bansIssued         Ban[]                @relation("BannedByUser")
  pushDevices        PushDevice[]
  boosts             ServerBoost[]
  emoji              Emoji[]
}

/**
 * Телефон (или браузер), которому можно постучаться, когда мессенджер
 * закрыт.
 *
 * Подписку выдаёт не наш сервер, а служба доставки самого браузера:
 * мы получаем от неё адрес и два ключа, которыми шифруется письмо.
 * Прочитать его может только тот браузер, который подписался, —
 * служба доставки видит лишь запечатанный конверт.
 *
 * Строк на человека несколько: телефон, ноутбук, второй браузер.
 * Каждая живёт своей жизнью и умирает сама, когда браузер отвечает
 * «такой подписки больше нет».
 */
model PushDevice {
  id       String @id
  userId   String
  /// Адрес, по которому служба доставки принимает письма для этого
  /// браузера. Уникален: он и есть удостоверение подписки.
  endpoint String @unique
  /// Открытый ключ браузера и общая соль — ими шифруется содержимое.
  p256dh   String
  auth     String
  /// Чем подписались. Нужно только человеку в настройках: понять,
  /// какое из устройств в списке — это то, что в руках.
  label    String?

  createdAt DateTime @default(now())
  /// Когда письмо последний раз дошло. По нему видно мёртвые подписки,
  /// о которых служба доставки почему-то не сказала.
  usedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Дружба хранится одной строкой на пару, а не двумя зеркальными.
// Две строки пришлось бы держать согласованными вручную, и рано или
// поздно они разошлись бы: у одного друг есть, у другого нет.
model Friendship {
  id          String    @id
  requesterId String
  addresseeId String
  // PENDING — заявка отправлена, ACCEPTED — дружба состоялась.
  // Отклонённые не храним: строка просто удаляется, иначе человек
  // не смог бы попросить второй раз.
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  // Пара уникальна в одну сторону. Встречную заявку ловим отдельной
  // проверкой в коде: индекс её не поймает, порядок полей другой.
  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model RefreshToken {
  id        String    @id
  userId    String
  tokenHash String    @unique // храним хеш, не сам токен
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  /** Чем зашли: приложение или браузер.
   *
   *  Из user-agent это выводится не всегда. Приложение на компьютере
   *  ещё можно узнать по слову Electron, а вот приложение на телефоне
   *  от вкладки браузера ничем не отличается: Android показывает
   *  установленному приложению ровно тот же user-agent. Поэтому клиент
   *  говорит о себе сам — заголовком, который ставит при входе. */
  client    String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Серверы и каналы ────────────────────────────────────────

model Server {
  id        String   @id
  name      String
  iconUrl   String?
  /** Баннер над списком каналов. Открывается со второго уровня буста;
   *  загруженный когда-то остаётся лежать, но наружу не отдаётся,
   *  пока уровень не вернётся. */
  bannerUrl String?
  ownerId   String
  createdAt DateTime @default(now())

  owner    User           @relation("ServerOwner", fields: [ownerId], references: [id])
  channels Channel[]
  members  ServerMember[]
  invites  Invite[]
  bans     Ban[]
  boosts   ServerBoost[]
  emoji    Emoji[]

  @@index([ownerId])
}

/**
 * Своё эмодзи сервера — награда третьего уровня.
 *
 * Имя уникально внутри сервера, а не глобально: в сообщении оно стоит
 * как `:название:`, и два одинаковых имени на одном сервере означали бы,
 * что непонятно, какая картинка нарисуется.
 */
model Emoji {
  id        String   @id
  serverId  String
  name      String
  /** Ссылка на нашу же загрузку — та же, что у аватаров. */
  url       String
  createdBy String
  createdAt DateTime @default(now())

  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id])

  @@unique([serverId, name])
  @@index([serverId])
}

/**
 * Поддержка сервера участником — один буст на человека.
 *
 * Денег здесь нет и не будет: это не покупка, а голос за то, чтобы
 * сервер подрос. Уникальность по паре (сервер, человек) и есть всё
 * правило: нажал — поддержал, нажал ещё раз — снял.
 */
model ServerBoost {
  id        String   @id
  serverId  String
  userId    String
  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([serverId])
}

// Бан — это запись о запрете, а не отсутствие членства.
// Просто удалить участника мало: он вернётся по той же ссылке через
// минуту. Поэтому строка живёт отдельно и переживает выход.
model Ban {
  serverId  String
  userId    String
  reason    String?
  bannedById String
  createdAt DateTime @default(now())

  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user     User   @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy User   @relation("BannedByUser", fields: [bannedById], references: [id])

  @@id([serverId, userId])
  @@index([userId])
}

model ServerMember {
  serverId String
  userId   String
  role     String   @default("MEMBER") // OWNER | ADMIN | MEMBER
  nickname String?
  joinedAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([serverId, userId])
  @@index([userId])
}

// Каналы сервера И личные переписки живут в одной таблице.
// serverId = null означает ЛС. Так у Message один внешний ключ вместо
// двух, и вся логика сообщений пишется один раз.
model Channel {
  id        String   @id
  serverId  String?
  type      String // TEXT | VOICE | DM | GROUP_DM
  name      String? // null для личных переписок
  topic     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  server       Server?              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants ChannelParticipant[]
  readStates   ReadState[]

  @@index([serverId, position])
}

// Только для ЛС и групповых ЛС
model ChannelParticipant {
  channelId String
  userId    String
  addedAt   DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

// ─── Сообщения ───────────────────────────────────────────────

model Message {
  id        String    @id // ULID: сортируется по времени сам
  channelId String
  authorId  String
  content   String
  replyToId String?
  editedAt  DateTime?
  deletedAt DateTime? // мягкое удаление
  createdAt DateTime  @default(now())

  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  replyTo     Message?     @relation("Reply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]    @relation("Reply")
  attachments Attachment[]
  reactions   Reaction[]

  // Главный индекс проекта. Без него выборка истории канала
  // превращается в полное сканирование таблицы.
  @@index([channelId, id(sort: Desc)])
  @@index([authorId])
}

model Attachment {
  id String @id

  // Файл загружается до отправки сообщения — пока человек дописывает
  // текст, он уже лежит на диске. Поэтому связь необязательная:
  // сначала появляется вложение, потом сообщение, к которому его
  // привязывают. Неприкреплённые подчищает npm run db:cleanup.
  messageId String?

  uploaderId String
  filename   String // как назвал пользователь — только для показа
  storageKey String @unique // как лежит на диске — генерируем сами
  size       Int
  mimeType   String
  width      Int?
  height     Int?
  /** Длительность голосового сообщения в секундах.
   *
   *  Хранится, а не считается на месте, из-за известной особенности
   *  записи в браузере: Chrome пишет webm без длительности в заголовке,
   *  и проигрыватель показывает «бесконечность», пока не домотает
   *  запись до конца. Клиент знает длительность в момент записи —
   *  он её и присылает. */
  duration   Int?
  createdAt  DateTime @default(now())

  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId])
}

model Reaction {
  messageId String
  userId    String
  emoji     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
}

// ─── Приглашения и непрочитанное ─────────────────────────────

model Invite {
  code      String    @id // 8 символов
  serverId  String
  creatorId String
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator User   @relation("InviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([serverId])
}

model ReadState {
  userId            String
  channelId         String
  lastReadMessageId String?
  mentionCount      Int     @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}
