# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# ── База данных ──────────────────────────────────────────────
# Пароль — тот, что задали при установке PostgreSQL.
DATABASE_URL="postgresql://postgres:ПАРОЛЬ@localhost:5432/messenger?schema=public"

# ── Секреты ──────────────────────────────────────────────────
# Минимум 32 символа. Сгенерировать новый:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="замените-на-случайную-строку-минимум-32-символа"

# ── Сервер ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# ── Время жизни токенов ──────────────────────────────────────
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# ── Кто может зарегистрироваться ─────────────────────────────
# Пока строка пуста или отсутствует, завести учётную запись может
# любой, кто узнал адрес. Адрес виден в интернете, поэтому для
# компании друзей код нужен.
#
# Годится и он, и код действующего приглашения: пришедшему по ссылке
# ничего вводить не придётся.
SIGNUP_CODE="придумайте-короткий-код"

# ── Почта: коды подтверждения ────────────────────────────────
# Необязательно. Без этих строк мессенджер работает, просто не шлёт
# писем, и почта у всех остаётся неподтверждённой.
#
# SMTP_PASS — это НЕ пароль от ящика, а «пароль приложения»:
# Яндекс ID → Безопасность → Пароли приложений → Почта.
# Обычный пароль Яндекс по SMTP не примет.
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT=465
SMTP_USER="вашящик@yandex.ru"
SMTP_PASS="пароль-приложения"
# Только адрес, без имени отправителя — имя подставляет сам сервер.
MAIL_FROM="вашящик@yandex.ru"

# ── Ретранслятор голоса (TURN) ────────────────────────────────
#
# Нужен, когда прямое соединение между собеседниками не строится:
# симметричный NAT у одного, общий адрес провайдера у другого.
# Без него такие разговоры не состоятся вовсе.
#
# Живёт в этом же процессе. Включается наличием секрета — им
# подписываются временные пароли, которые сервер выдаёт браузеру.
# Постоянного пароля у TURN нет и быть не может: он уезжает
# каждому клиенту и секретом не является.
#
#   TURN_SECRET=<не короче 24 символов, случайные>
#
# Порт должен быть проброшен на роутере — иначе друзья из интернета
# до ретранслятора не достучатся, и он будет работать только внутри
# домашней сети.
TURN_SECRET=
TURN_PORT=3478
# Каким адресом ретранслятор виден снаружи: внешний IP или домен.
# Пусто — берётся адрес в домашней сети (годится только для проверок).
TURN_HOST=

# Уведомления на закрытый телефон.
#
# Пара ключей, которой сервер представляется службе доставки браузера.
# Сделать свою: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Пусто — уведомления выключены, всё остальное работает как обычно.
# Закрытый ключ — тайна: сменив пару, придётся переподписывать телефоны.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid
