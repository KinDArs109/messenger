{
  "name": "messenger",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/admin"
  ],
  "scripts": {
    "dev": "concurrently -n сервер,клиент -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @messenger/server",
    "dev:web": "npm run dev --workspace @messenger/web",
    "build": "npm run build --workspace @messenger/web",
    "start": "cross-env NODE_ENV=production npm run start --workspace @messenger/server",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server && tsc -p apps/web",
    "db:migrate": "npm run db:migrate --workspace @messenger/server",
    "db:seed": "npm run db:seed --workspace @messenger/server",
    "db:studio": "npm run db:studio --workspace @messenger/server",
    "db:reset": "npm run db:reset --workspace @messenger/server",
    "check:realtime": "npm run check:realtime --workspace @messenger/server",
    "db:cleanup": "npm run db:cleanup --workspace @messenger/server",
    "db:password": "npm run db:password --workspace @messenger/server",
    "db:up": "npm run db:up --workspace @messenger/server",
    "db:down": "npm run db:down --workspace @messenger/server",
    "db:status": "npm run db:status --workspace @messenger/server",
    "check:db": "npm run check:db --workspace @messenger/server",
    "check:nat": "npm run check:nat --workspace @messenger/server",
    "check:screen": "npm run check:screen --workspace @messenger/server",
    "check:images": "npm run check:images --workspace @messenger/server",
    "check:upload": "npm run check:upload --workspace @messenger/server",
    "stress": "npm run stress --workspace @messenger/server",
    "check:video": "npm run check:video --workspace @messenger/server",
    "check:roster": "npm run check:roster --workspace @messenger/server",
    "check:echo": "npm run check:echo -w @messenger/web",
    "check:pictures": "npm run check:pictures -w @messenger/server",
    "check:turn": "npm run check:turn -w @messenger/server",
    "check:deafen": "npm run check:deafen -w @messenger/web",
    "bench": "npm run bench --workspace @messenger/server",
    "check:speaking": "npm run check:speaking -w @messenger/web",
    "check:contrast": "npm run check:contrast -w @messenger/web",
    "check:amplify": "npm run check:amplify -w @messenger/web",
    "check:alerts": "npm run check:alerts -w @messenger/web",
    "check:people": "npm run check:people -w @messenger/web"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true
  }
}
